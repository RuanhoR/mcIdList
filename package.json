{
  "name": "@ojaang/be-vanilla-iddata",
  "version": "1.26.40-rc.1",
  "description": "Minecraft Vanilla Id Data On NPM",
  "main": "./index.js",
  "repository": {
    "directory": "/",
    "type": "git",
    "url": "https://github.com/RuanhoR/mcIdList"
  },
  "homepage": "https://github.com/RuanhoR/mcIdList",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "push": "node ./scripts/push.js \"$@\" && pnpm publish --tag latest"
  },
  "files": [
    "./data/be_1.26.40.json",
    "index.js",
    "index.d.ts"
  ],
  "exports": {
    ".": {
      "require": "./index.js",
